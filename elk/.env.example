# ============================================================================
#  ARGUS — exemple de variables d'environnement
#  Copier vers l'emplacement réel puis remplacer chaque "changeme".
#  NE JAMAIS committer les fichiers réels (.env, /etc/argus-*.env, ~/.elklab_env).
# ============================================================================

# --- Elasticsearch / Kibana ---------------------------------------------
ES_HOST=changeme
ES_CA_CERTS=changeme
ELASTIC_API_KEY_ID=changeme
ELASTIC_API_KEY=changeme

# --- Groq (LLM du chat et de l'agent courriel) --------------------------
GROQ_MODEL=changeme
GROQ_API_KEY=changeme

# --- Serveur MCP ---------------------------------------------------------
MCP_URL=changeme

# --- Chat analyste (Basic Auth) -----------------------------------------
CHAT_PORT=changeme
CHAT_USER=changeme
CHAT_PASS=changeme

# --- Agent courriel ------------------------------------------------------
SMTP_HOST=changeme
SMTP_PORT=changeme
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=changeme
SMTP_TO=changeme
SMTP_STARTTLS=changeme
ALERT_LOOKBACK=changeme
POLL_INTERVAL=changeme
RULE_COOLDOWN_MINUTES=changeme
